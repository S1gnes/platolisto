{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "platolisto-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // Comma-separated list of origins allowed to call the proxy.
    "ALLOWED_ORIGINS": "https://s1gnes.github.io,http://localhost:5173,http://127.0.0.1:5173",
    // Model IDs change often on the free tier: check https://ai.google.dev/gemini-api/docs/models
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
    "TRANSLATE_MODEL": "gemini-3.5-flash-lite",
    "CHAT_MODEL": "gemini-3.8-flash",
    // Spoonacular allows caching only with written permission, for at most 3600 s. Keep 0 until then.
    "SPOONACULAR_CACHE_TTL": "0",
    // Requests per minute per IP (used when the rate limiting binding is not available).
    "RATE_LIMIT_PER_MINUTE": "30"
  },
  // Per-IP rate limit. Remove this block if your plan rejects it; the in-memory fallback takes over.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
